          "version": 3,
          "body": "<style>\n    :root {--espresso: #241a17;--coffee: #35251f;--mint: #a8e6cf;--mint-light: #dff5ec;--paper: #f5f0e8;--cream: #fffaf1;--ink: #1d1715;--muted: #756a65;--line: #d7cec4;--white: #ffffff;--radius: 4px;--shadow: 0 18px 50px rgba(36, 26, 23, .1)}\n\n    * {box-sizing: border-box}\n\n    html {}\n\n    body {margin: 0;color: var(--ink);background: var(--paper);font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif;line-height: 1.7;-webkit-font-smoothing: antialiased}\n\n    a {color: inherit;text-decoration: none}\n\n    .topbar {background: var(--espresso);color: var(--paper);border-bottom: 1px solid rgba(168, 230, 207, .32)}\n\n    .topbar-inner {max-width: 1180px;min-height: 42px;margin: 0 auto;padding: 8px 24px;display: flex;align-items: center;justify-content: space-between;gap: 24px;font-size: 12px;letter-spacing: .04em}\n\n    .topbar nav {display: flex;align-items: center;gap: 22px}\n\n    .topbar nav a {color: #d8d0c8;transition: color .2s ease}\n\n    .topbar nav a:hover {color: var(--mint)}\n\n    .status {display: inline-flex;align-items: center;gap: 8px;color: var(--mint)}\n\n    .status::before {content: \"\";width: 6px;height: 6px;border-radius: 50%;background: currentColor}\n\n    .hero {position: relative;overflow: hidden;background: var(--espresso);color: var(--paper)}\n\n    .hero::after {content: \"\";position: absolute;right: -120px;top: -160px;width: 520px;height: 520px;border: 1px solid rgba(168, 230, 207, .2);border-radius: 50%;pointer-events: none}\n\n    .hero-grid {position: relative;z-index: 1;max-width: 1180px;margin: 0 auto;padding: 72px 24px 88px;display: grid;grid-template-columns: minmax(0, 1.45fr) minmax(280px, .75fr);gap: 56px;align-items: end}\n\n    .eyebrow {margin: 0 0 20px;color: var(--mint);font-size: 12px;font-weight: 700;letter-spacing: .18em;text-transform: uppercase}\n\n    h1 {max-width: 820px;margin: 0;font-family: Geor