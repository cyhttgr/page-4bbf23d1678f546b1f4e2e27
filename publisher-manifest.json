order-radius: var(--radius);transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease}\n\n    .plan:hover {transform: translateY(-3px);border-color: var(--mint);box-shadow: var(--shadow)}\n\n    .plan.featured {background: var(--mint-light)}\n\n    .plan-badge {position: absolute;top: 18px;right: 20px;padding: 4px 10px;background: var(--espresso);color: var(--mint);font-size: 11px;letter-spacing: .08em}\n\n    .plan h3 {margin: 0 0 8px;font-family: Georgia, \"Songti SC\", serif;font-size: 32px;font-weight: 500}\n\n    .plan-subtitle {margin: 0;color: var(--muted);font-size: 13px}\n\n    .plan-features {margin: 0;padding: 0;list-style: none;display: grid;grid-template-columns: repeat(2, minmax(0, 1fr));gap: 10px 24px}\n\n    .plan-features li {position: relative;padding-left: 20px;font-size: 14px}\n\n    .plan-features li::before {content: \"\";position: absolute;left: 0;top: .72em;width: 8px;height: 1px;background: var(--coffee)}\n\n    .price {text-align: right}\n\n    .price-main {margin: 0;font-family: Georgia, \"Songti SC\", serif;font-size: 36px;line-height: 1.1}\n\n    .price-main small {font-family: inherit;font-size: 14px}\n\n    .price-annual {margin: 8px 0 0;color: var(--muted);font-size: 13px}\n\n    .price-caption {margin: 14px 0 0;color: var(--muted);font-size: 11px;line-height: 1.5}\n\n    .notice {margin-top: 26px;padding: 18px 22px;border-left: 3px solid var(--mint);background: rgba(168, 230, 207, .16);color: #5f524d;font-size: 13px}\n\n    .client-grid {display: grid;grid-template-columns: .9fr 1.1fr;gap: 70px;align-items: start}\n\n    .client-panel {padding: 34px;background: var(--espresso);color: var(--paper);box-shadow: var(--shadow)}\n\n    .client-panel .eyebrow {margin-bottom: 14px}\n\n    .client-panel h3 {margin: 0 0 18px;font-family: Georgia, \"Songti SC\", serif;font-size: 30px;font-weight: 500}\n\n    .client-panel p {margin: 0;color: #d7cec6;font-size: 14px}\n\n    .client-panel .pending {margin-top: 26px;padding-top: 22px;border-top: 1px solid rgba(245, 240, 232, .2);color: var(--mint);font-size: 13px}\n\n    .steps {counter-reset: client-step}\n\n    .step {counter-increment: client-step;display: grid;grid-template-columns: 58px 1fr;gap: 20px;padding: 26px 0;border-top: 1px solid var(--line)}\n\n    .step:last-child {border-bottom: 1px solid var(--line)}\n\n    .step::before {content: \"0\" counter(client-step);color: var(--muted);font-family: Georgia, serif;font-size: 22px}\n\n    .step h3 {margin: 0 0 7px;font-size: 18px}\n\n    .step p {margin: 0;color: var(--muted);font-size: 14px}\n\n    .guide {background: var(--cream)}\n\n    .guide-inner {max-width: 1180px;margin: 0 auto;padding: 92px 24px}\n\n    .guide-layout {display: grid;grid-template-columns: .85fr 1.15fr;gap: 70px}\n\n    .guide-lead {position: sticky;top: 32px;align-self: start}\n\n    .guide-lead p {max-width: 430px;margin: 20px 0 0;color: var(--muted)}\n\n    .guide-list {margin: 0;padding: 0;list-style: none}\n\n    .guide-list li {display: grid;grid-template-columns: 108px 1fr;gap: 24px;padding: 28px 0;border-top: 1px solid var(--line)}\n\n    .guide-list li:last-child {border-bottom: 1px solid var(--line)}\n\n    .guide-list strong {font-size: 14px}\n\n    .guide-list span {color: var(--muted);font-size: 14px}\n\n    .faq-wrap {max-width: 900px;margin: 0 auto}\n\n    details {border-top: 1px solid var(--line)}\n\n    details:last-of-type {border-bottom: 1px solid var(--line)}\n\n    summary {position: relative;padding: 25px 48px 25px 0;cursor: pointer;list-style: none;font-size: 17px;font-weight: 650}\n\n    summary::-webkit-details-marker {display: none}\n\n    summary::after {content: \"+\";position: absolute;right: 8px;top: 22px;color: var(--coffee);font-family: Georgia, serif;font-size: 25px;font-weight: 400}\n\n    details[open] summary::after {content: \"−\"}\n\n    .answer {max-width: 760px;padding: 0 42px 26px 0;color: var(--muted);font-size: 14px}\n\n    .answer p {margin: 0 0 10px}\n\n    .answer p:last-child {margin-bottom: 0}\n\n    .cta {padding: 72px 24px;background: var(--mint)}\n\n    .cta-inner {max-width: 1180px;margin: 0 auto;display: flex;align-items: end;justify-content: space-between;gap: 40px}\n\n    .cta h2 {max-width: 720px;font-size: clamp(32px, 5vw, 54px)}\n\n    .cta p {max-width: 640px;margin: 16px 0 0;color: #425049;font-size: 14px}\n\n    .cta-links {display: flex;flex-wrap: wrap;gap: 18px;flex-shrink: 0}\n\n    .cta-links a {padding: 12px 18px;border: 1px solid var(--espresso);color: var(--espresso);font-size: 13px;transition: background .2s ease, color .2s ease}\n\n    .cta-links a:first-child {background: var(--espresso);color: var(--paper)}\n\n    .cta-links a:hover {background: var(--cream);color: var(--espresso)}\n\n    footer {background: var(--espresso);color: #bdb3aa}\n\n    .footer-inner {max-width: 1180px;margin: 0 auto;padding: 38px 24px;display: flex;justify-content: space-between;gap: 30px;font-size: 12px}\n\n    .footer-brand {color: var(--mint);font-size: 15px;font-weight: 700}\n\n    .footer-links {display: flex;flex-wrap: wrap;gap: 20px}\n\n    @media (max-width: 900px) {\n      .hero-grid,\n      .section-heading,\n      .client-grid,\n      .guide-layout {grid-template-columns: 1fr}\n\n      .hero-grid {gap: 38px}\n\n      .principles {grid-template-columns: 1fr}\n\n      .principle {padding: 26px 0}\n\n      .principle + .principle {padding-left: 0;border-left: 0;border-top: 1px solid var(--line)}\n\n      .plan {grid-template-columns: 1fr;gap: 24px}\n\n      .price {text-align: left}\n\n      .client-grid,\n      .guide-layout {gap: 44px}\n\n      .guide-lead {position: static}\n\n      .cta-inner,\n      .footer-inner {align-items: flex-start;flex-direction: column}\n    }\n\n    @media (max-width: 620px) {\n      .topbar-inner {align-items: flex-start;flex-direction: column;gap: 7px}\n\n      .topbar nav {width: 100%;gap: 15px;overflow-x: auto;white-space: nowrap}\n\n      .hero-grid {padding: 54px 20px 64px}\n\n      h1 {font-size: clamp(46px, 16vw, 72px)}\n\n      .section,\n      .guide-inner {padding: 68px 20px}\n\n      .section-heading {gap: 18px;margin-bottom: 36px}\n\n      .plan {padding: 30px 24px}\n\n      .plan-features {grid-template-columns: 1fr}\n\n      .guide-list li {grid-template-columns: 1fr;gap: 7px}\n\n      .client-panel {padding: 28px 24px}\n\n      .cta {padding: 60px 20px}\n\n      .footer-inner {padding: 32px 20px}\n    }\n  </style><header class=\"topbar\">\n    <div class=\"topbar-inner\">\n      <a href=\"#top\" aria-label=\"返回页面顶部\">IPLCCloud · 套餐与使用说明</a>\n      <nav aria-label=\"页面导航\">\n        <a href=\"#overview\">方案概览</a>\n        <a href=\"#plans\">套餐参考</a>\n        <a href=\"#clients\">客户端准备</a>\n        <a href=\"#guide\">使用说明</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n    </div>\n  </header>\n\n  <main id=\"top\">\n    <section class=\"hero\">\n      <div class=\"hero-grid\">\n        <div>\n          <p class=\"eyebrow\">Package · Client · Guide</p>\n          <h1 id=\"hero-title\">IPLCCloud · 先看方案，<br>再完成<span>连接准备</span></h1>\n          <p class=\"hero-lead\">IPLCCloud 机场套餐、客户端准备与使用说明集中整理。这里不夸大服务能力，也不替代购买页；涉及价格、流量和设备数量的信息，均应在下单前再次核对。</p>\n        </div>\n\n        <aside class=\"hero-note\" aria-label=\"信息提示\">\n          <p class=\"hero-note-label\">阅读提示 / INFORMATION</p>\n          <p>页面采用参考套餐结构展示不同档位。当前未提供已确认的客户端下载地址与购买入口，因此相关位置保留为核验指引，不提供未经确认的链接。</p>\n          <a href=\"#plans\">查看套餐参考 ↓</a>\n        </aside>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"overview\">\n      <div class=\"section-heading\">\n        <p class=\"section-index\">01 / OVERVIEW</p>\n        <div>\n          <h2 id=\"overview-title\">从需求出发，<br>选择对应档位</h2>\n          <p class=\"section-intro\">IPLCCloud 的不同套餐可按流量额度、同时在线设备数量及附加需求进行区分。下列内容为套餐参考，实际服务内容应以购买时展示的信息为准。</p>\n        </div>\n      </div>\n\n      <div class=\"principles\">\n        <article class=\"principle\">\n          <strong>流量</strong>\n          <p>根据个人或团队的大致使用量选择月度额度，并为临时增量预留余量。</p>\n        </article>\n        <article class=\"principle\">\n          <strong>设备</strong>\n          <p>同时在线设备数量会直接影响方案选择，购买前应统计常用终端。</p>\n        </article>\n        <article class=\"principle\">\n          <strong>需求</strong>\n          <p>流媒体、路由或服务支持属于不同配置项，应逐项确认是否包含。</p>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"plans\">\n      <div class=\"section-heading\">\n        <p class=\"section-index\">02 / PACKAGES</p>\n        <div>\n          <h2 id=\"plans-title\">IPLCCloud 机场套餐参考</h2>\n          <p class=\"section-intro\">三档方案采用由基础到进阶的排列方式。价格与权益来自现有参考信息，正式购买前请核对周期、续费规则及服务条款。</p>\n        </div>\n      </div>\n\n      <div class=\"plans\">\n        <article class=\"plan\">\n          <div>\n            <h3>基础版</h3>\n            <p class=\"plan-subtitle\">适合轻度个人使用场景</p>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <div class=\"price\">\n            <p class=\"price-main\">¥15<small>/月</small></p>\n            <p class=\"price-annual\">按年付 ¥150/年</p>\n            <p class=\"price-caption\">价格以购买页面最终显示为准</p>\n          </div>\n        </article>\n\n        <article class=\"plan featured\">\n          <span class=\"plan-badge\">进阶参考</span>\n          <div>\n            <h3>旗舰版</h3>\n            <p class=\"plan-subtitle\">适合多设备与进阶使用需求</p>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>优先工单支持</li>\n          </ul>\n          <div class=\"price\">\n            <p class=\"price-main\">¥35<small>/月</small></p>\n            <p class=\"price-annual\">按年付 ¥350/年</p>\n            <p class=\"price-caption\">价格及服务内容以购买页面为准</p>\n          </div>\n        </article>\n\n        <article class=\"plan\">\n          <div>\n            <h3>团队版</h3>\n            <p class=\"plan-subtitle\">适合设备较多或团队协作场景</p>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <div class=\"price\">\n            <p class=\"price-main\">¥85<small>/月</small></p>\n            <p class=\"price-annual\">按年付 ¥850/年</p>\n            <p class=\"price-caption\">定制内容需在下单前单独确认</p>\n          </div>\n        </article>\n      </div>\n\n      <p class=\"notice\">说明：套餐名称、价格、流量、设备数量及权益为当前参考内容。购买时如页面信息与本页不一致，请以实际购买页面及服务方提供的条款为准。</p>\n    </section>\n\n    <section class=\"section\" id=\"clients\">\n      <div class=\"section-heading\">\n        <p class=\"section-index\">03 / CLIENT</p>\n        <div>\n          <h2 id=\"clients-title\">客户端准备，<br>先核验再安装</h2>\n          <p class=\"section-intro\">IPLCCloud 客户端的下载入口、系统版本要求与安装方式目前未提供已确认信息。准备连接时，应先向服务方取得准确来源，再按终端系统完成安装。</p>\n        </div>\n      </div>\n\n      <div class=\"client-grid\">\n        <aside class=\"client-panel\">\n          <p class=\"eyebrow\">Download Status</p>\n          <h3>机场客户端</h3>\n          <p>不要从来源不明的网盘、群聊附件或搜索结果中下载配置文件。客户端程序、订阅地址与配置文件属于不同内容，需分别核验。</p>\n          <p class=\"pending\">当前状态：尚未提供已确认的下载地址，因此本页不设置下载按钮。</p>\n        </aside>\n\n        <div class=\"steps\">\n          <article class=\"step\">\n            <div>\n              <h3>确认终端与系统</h3>\n              <p>先确定准备连接的个人电脑、手机或其他设备，并记录系统版本。当前资料未给出明确兼容范围，需以客户端发布说明为准。</p>\n            </div>\n          </article>\n          <article class=\"step\">\n            <div>\n              <h3>取得官方渠道信息</h3>\n              <p>从已确认的服务页面或服务方沟通渠道取得客户端与配置入口。收到链接后，检查域名、文件名称及安装提示是否一致。</p>\n            </div>\n          </article>\n          <article class=\"step\">\n            <div>\n              <h3>安装并核对配置</h3>\n              <p>按照发布方说明完成安装，随后核对订阅地址、节点、端口及加密参数。若配置项与说明不一致，应暂停连接并重新确认。</p>\n            </div>\n          </article>\n          <article class=\"step\">\n            <div>\n              <h3>先测试再长期使用</h3>\n              <p>配置完成后先进行短时连接测试，再投入日常使用。遇到连接异常时，保留客户端提示与时间信息，便于排查和咨询。</p>\n            </div>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"guide\" id=\"guide\">\n      <div class=\"guide-inner\">\n        <div class=\"guide-layout\">\n          <div class=\"guide-lead\">\n            <p class=\"section-index\">04 / GUIDE</p>\n            <h2 id=\"guide-title\">使用说明</h2>\n            <p>建议按照“选套餐—取得客户端—导入配置—连接测试—检查用量”的顺序完成首次使用。不要跳过来源核验与短期测试。</p>\n          </div>\n\n          <ol class=\"guide-list\">\n            <li>\n              <strong>01 选择套餐</strong>\n              <span>根据预计流量和同时在线设备数选择方案；涉及企业路由或专属服务时，先确认具体交付范围。</span>\n            </li>\n            <li>\n              <strong>02 核对周期</strong>\n              <span>区分月付与年付展示价格，确认续费方式、计费起点及服务规则，避免只比较单月数字。</span>\n            </li>\n            <li>\n              <strong>03 准备客户端</strong>\n              <span>从已确认渠道取得适配当前终端的客户端程序，并查看对应版本说明与配置要求。</span>\n            </li>\n            <li>\n              <strong>04 导入配置</strong>\n              <span>核对订阅地址、节点、端口与认证信息，敏感参数不要上传到公开群聊或不可信网站。</span>\n            </li>\n            <li>\n              <strong>05 连接测试</strong>\n              <span>先连接单个终端进行短时测试，确认基本可用后再逐步增加设备数量。</span>\n            </li>\n            <li>\n              <strong>06 查看用量</strong>\n              <span>使用过程中定期检查剩余流量和设备数量，避免无意超出套餐包含的额度。</span>\n            </li>\n            <li>\n              <strong>07 处理异常</strong>\n              <span>记录错误提示、发生时间、客户端版本和所选节点，再依据发布说明排查或提交工单。</span>\n            </li>\n          </ol>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"faq\">\n      <div class=\"section-heading\">\n        <p class=\"section-index\">05 / FAQ</p>\n        <div>\n          <h2 id=\"faq-title\">常见问题</h2>\n          <p class=\"section-intro\">关于套餐选择、客户端准备和连接排查，先查看以下说明。涉及具体规则时，以购买页面与实际服务条款为准。</p>\n        </div>\n      </div>\n\n      <div class=\"faq-wrap\">\n        <details>\n          <summary>基础版、旗舰版和团队版应该如何选择？</summary>\n          <div class=\"answer\">\n            <p>基础版参考配置为每月 100GB 流量和 3 台设备同时在线；旗舰版参考配置为每月 300GB 流量和 5 台设备同时在线；团队版参考配置为每月 1000GB 流量和 20 台设备同时在线。</p>\n            <p>选择时可先统计设备数量与大致用量，再核对是否需要流媒体、游戏加速、定制路由或专属服务。实际交付内容以购买页面为准。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>月付和年付应该怎样核算？</summary>\n          <div class=\"answer\">\n            <p>当前参考价格为基础版 ¥15/月、旗舰版 ¥35/月、团队版 ¥85/月，对应年付展示价格分别为 ¥150、¥350 和 ¥850。下单前应确认年付价格是否包含同样权益，以及到期后的续费规则。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>IPLCCloud 客户端在哪里下载？</summary>\n          <div class=\"answer\">\n            <p>当前没有提供已确认的客户端下载地址，因此本页不提供下载链接。建议从已核验的服务页面或服务方沟通渠道取得客户端程序与配置入口，并检查来源是否一致。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>手机和电脑都能使用同一个套餐吗？</summary>\n          <div class=\"answer\">\n            <p>套餐参考信息按同时在线设备数量区分，但没有提供明确的系统兼容列表。可使用的终端类型与系统版本，应以对应客户端的发布说明为准；购买前也可向服务方确认。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>连接失败时应该检查什么？</summary>\n          <div class=\"answer\">\n            <p>先确认订阅或配置是否成功导入，再检查节点状态、参数是否完整、系统时间是否准确，以及当前网络能否访问相关服务。若问题仍存在，请记录错误提示、发生时间、客户端版本和节点信息后再提交工单。</p>\n          </div>\n        </details>\n\n        <details>\n          <summary>页面价格与实际购买页不一致怎么办？</summary>\n          <div class=\"answer\">\n            <p>以实际购买页面及服务方提供的条款为准。本页展示的是参考套餐信息，不构成价格承诺；如发现名称、价格、流量、设备数量或权益不一致，应在付款前暂停并向服务方核实。</p>\n          </div>\n        </details>\n      </div>\n    </section>\n\n    <section class=\"cta\">\n      <div class=\"cta-inner\">\n        <div>\n          <h2 id=\"cta-title\">先完成核验，<br>再开始连接。</h2>\n          <p>确认套餐内容、客户端来源与配置文件来源后，再进行安装和连接测试。未确认的信息应向服务方核实，不通过公开来源自行补全。</p>\n        </div>\n        <div class=\"cta-links\" aria-label=\"页面快捷入口\">\n          <a href=\"#plans\">查看套餐</a>\n          <a href=\"#clients\">客户端准备</a>\n          <a href=\"#faq\">常见问题</a>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"footer-inner\">\n      <div>\n        <div class=\"footer-brand\">IPLCCloud</div>\n        <p>机场套餐、客户端与使用说明参考页面</p>\n      </div>\n      <div class=\"footer-links\">\n        <a href=\"#overview\">方案概览</a>\n        <a href=\"#plans\">套餐参考</a>\n        <a href=\"#guide\">使用说明</a>\n        <a href=\"#faq\">常见问题</a>\n      </div>\n    </div>\n  </footer>",
